{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "osvault",
    "version": "0.1.0",
    "description": "A C++23 library for platform-native protected storage",
    "license": "MIT",
    "dependencies": [
        {
            "name": "libsecret",
            "default-features": false,
            "platform": "linux"
        }
    ],
    "features": {
        "tests": {
            "description": "Build the test suite",
            "dependencies": [
                {
                    "name": "catch2",
                    "default-features": false,
                    "version>=": "3.16.0"
                }
            ]
        }
    }
}
