{
    "version": 4,
    "include": [
        "base.json"
    ],
    "configurePresets": [
        {
            "name": "mac-clang",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++"
            }
        },
        {
            "name": "mac-clang-dbg",
            "inherits": "mac-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "mac-clang-rel",
            "inherits": "mac-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "mac-clang-reldbg",
            "inherits": "mac-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "mac-clang-minrel",
            "inherits": "mac-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "mac",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "mac-clang-dbg",
            "configurePreset": "mac-clang-dbg",
            "inherits": "mac"
        },
        {
            "name": "mac-clang-rel",
            "configurePreset": "mac-clang-rel",
            "inherits": "mac"
        },
        {
            "name": "mac-clang-reldbg",
            "configurePreset": "mac-clang-reldbg",
            "inherits": "mac"
        },
        {
            "name": "mac-clang-minrel",
            "configurePreset": "mac-clang-minrel",
            "inherits": "mac"
        }
    ]
}
