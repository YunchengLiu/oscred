---
Checks: >-
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  google-build-using-namespace,
  google-build-explicit-make-pair,
  google-explicit-constructor,
  google-global-names-in-headers,
  google-readability-casting,
  google-runtime-int,
  google-runtime-operator,
  llvm-namespace-comment,
  misc-unused-parameters,
  misc-unused-using-decls,
  misc-definitions-in-headers,
  misc-confusable-identifiers,
  misc-include-cleaner,
  cert-msc50-cpp,
  cert-msc51-cpp,
  cert-oop57-cpp,
  cert-dcl58-cpp,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -modernize-use-trailing-return-type,
  -portability-avoid-pragma-once,
  -portability-restrict-system-includes,
  -portability-simd-intrinsics,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-redundant-casting,
  -readability-use-concise-preprocessor-directives

WarningsAsErrors: '*'
HeaderFilterRegex: '(^|.*[/\\])osvault[/\\].*\.h$'
ExcludeHeaderFilterRegex: '(^|.*[/\\])(build[^/\\]*|deps|vcpkg_installed|MSVC)[/\\].*'
FormatStyle: file
HeaderFileExtensions: [h]
ImplementationFileExtensions: [cpp]
SystemHeaders: false
CheckOptions:
    # Win32 uses Windows.h as an umbrella; keep include checks for project and standard headers
    misc-include-cleaner.IgnoreHeaders: '[/\\]Windows Kits[/\\].*[/\\](um|shared)[/\\].*'
    cppcoreguidelines-macro-usage.AllowedRegexp: '^OSVAULT_.*'
    readability-function-cognitive-complexity.IgnoreMacros: true
    readability-identifier-naming.NamespaceCase: lower_case
    readability-identifier-naming.ClassCase: lower_case
    readability-identifier-naming.StructCase: lower_case
    readability-identifier-naming.UnionCase: lower_case
    readability-identifier-naming.EnumCase: lower_case
    readability-identifier-naming.TypeAliasCase: lower_case
    readability-identifier-naming.TypedefCase: lower_case
    readability-identifier-naming.FunctionCase: lower_case
    readability-identifier-naming.VariableCase: lower_case
    readability-identifier-naming.ParameterCase: lower_case
    readability-identifier-naming.MemberCase: lower_case
    readability-identifier-naming.PrivateMemberSuffix: '_'
    readability-identifier-naming.ProtectedMemberSuffix: '_'
    readability-identifier-naming.EnumConstantCase: lower_case
    readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
    readability-identifier-naming.TypeTemplateParameterCase: CamelCase
...
